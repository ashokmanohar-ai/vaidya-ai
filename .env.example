# Copy to .env. The .env file is ignored by Git and excluded from the ZIP.
# Demo processes synthetic text only; no real patient data.
DEMO_MODE=false
APP_ENV=development
PORT=5055
FLASK_SECRET_KEY=replace-with-a-long-local-random-secret
LLM_PROVIDER=demo
# Change to bedrock only after supplying your secret and explicitly opting in below.
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1
AWS_BEARER_TOKEN_BEDROCK=
# Restrict model selection to Bedrock IDs approved for this account and region.
BEDROCK_MODELS=in.openai.gpt-5.6-terra,in.openai.gpt-5.6-luna,global.openai.gpt-5.6-sol,global.anthropic.claude-sonnet-5,global.amazon.nova-2-lite-v1:0,openai.gpt-oss-120b-1:0
LLM_EXTRACTION_MODEL=in.openai.gpt-5.6-terra
# Reserved for the future optional LLM-assisted learner; not currently invoked.
LLM_LEARNING_MODEL=in.openai.gpt-5.6-luna
ALLOW_REMOTE_SYNTHETIC_INPUT=false
# Optional, ONLY where the selected Bedrock model/inference profile supports it.
BEDROCK_STRUCTURED_OUTPUT=false
# Optional inference controls
BEDROCK_MAX_OUTPUT_TOKENS=1800
# BEDROCK_TEMPERATURE=0
# VAIDYA_DATA_DIR=C:/your/private/demo/instance

# Multilingual pipeline. Set TRANSLATION_PROVIDER=bedrock for a REAL remote
# translation call; passthrough retains text verbatim and displays warnings.
ASR_PROVIDER=faster-whisper
WHISPER_MODEL_SIZE=tiny
# WHISPER_MODEL_PATH=C:/approved/local/model/folder
TRANSLATION_PROVIDER=passthrough
LLM_TRANSLATION_MODEL=in.openai.gpt-5.6-luna
# Audio model may need an initial download; approve/cache before offline demos.
